<!--custom-tab-bar/index.wxml-->
<view class="tabbar">
  <view
    class="tab"
    wx:for="{{list}}"
    wx:key="id"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tab-icon">{{item.icon}}</text>
    <text class="tab-label {{selected === index ? 'active' : ''}}">{{item.label}}</text>
  </view>
</view>

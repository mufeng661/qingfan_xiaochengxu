/**pages/stats/index.wxss**/
page {
  background-color: var(--bg);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 44rpx 24rpx;
}

.title {
  font-family: serif;
  font-size: 48rpx;
  color: var(--ink);
}

.range {
  display: flex;
  gap: 12rpx;
}

.pill {
  font-size: 25rpx;
  color: var(--ink2);
  padding: 12rpx 26rpx;
  border-radius: 198rpx;
  border: 2rpx solid var(--line);
}

.pill.active {
  color: #ffffff;
  background-color: var(--leaf);
  border-color: var(--leaf);
}

.scroll {
  flex: 1;
  padding: 0 44rpx;
  box-sizing: border-box;
  background-color: var(--bg);
}

.range-title {
  font-family: serif;
  font-size: 32rpx;
  color: var(--ink);
  margin: 8rpx 0 28rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
}

.empty-text {
  font-size: 25rpx;
  color: var(--ink2);
  margin-top: 16rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 8rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.tl-row {
  display: flex;
}

.tl-left {
  flex: none;
  width: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: var(--surface);
  border: 6rpx solid var(--tomato);
  box-sizing: border-box;
  margin-top: 6rpx;
}

.tl-dot.aborted {
  border-color: var(--ink3);
}

.tl-bar {
  flex: 1;
  width: 3rpx;
  background-color: var(--leafSoft);
  margin-top: 6rpx;
}

.tl-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding-bottom: 32rpx;
}

.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tl-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tl-time {
  font-size: 22rpx;
  color: var(--ink3);
  flex: none;
  padding-left: 16rpx;
}

.tl-meta {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 8rpx;
}

.bottom-space {
  height: 220rpx;
}

<!--pages/stats/index.wxml-->
<view class="page theme-{{theme}}">
  <view class="header">
    <view class="title">时间轴</view>
    <view class="range">
      <view class="pill {{range === 'day' ? 'active' : ''}}" data-k="day" bindtap="setRange">日</view>
      <view class="pill {{range === 'week' ? 'active' : ''}}" data-k="week" bindtap="setRange">周</view>
      <view class="pill {{range === 'month' ? 'active' : ''}}" data-k="month" bindtap="setRange">月</view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="range-title">{{rangeTitle}}</view>

    <view class="empty" wx:if="{{rows.length === 0}}">
      <text class="empty-icon">🕒</text>
      <text class="empty-text">{{emptyHint}}</text>
      <text class="empty-hint">完成一个番茄后，这里会显示时间轴</text>
    </view>

    <view class="timeline" wx:else>
      <view class="tl-row" wx:for="{{rows}}" wx:key="index">
        <view class="tl-left">
          <view class="tl-dot {{item.done ? '' : 'aborted'}}"></view>
          <view class="tl-bar" wx:if="{{index < rows.length - 1}}"></view>
        </view>
        <view class="tl-body">
          <view class="tl-head">
            <text class="tl-title">{{item.title}}</text>
            <text class="tl-time">{{range === 'day' ? '' : item.date + ' '}}{{item.start}} – {{item.end}}</text>
          </view>
          <view class="tl-meta">专注 {{item.mins}} 分钟 · {{item.status}}</view>
        </view>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>

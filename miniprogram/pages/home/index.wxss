/**pages/home/index.wxss**/
page {
  background-color: var(--bg);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg);
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 44rpx 24rpx;
}

.date {
  font-family: serif;
  font-size: 26rpx;
  color: var(--ink2);
}

.greet {
  font-family: serif;
  font-size: 52rpx;
  color: var(--ink);
  margin-top: 8rpx;
}

.sign {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 28rpx;
  border-radius: 28rpx;
  background-color: var(--tomatoSoft);
  border: 2rpx solid #f0c9b8;
}

.sign.done {
  background-color: var(--surface);
  border-color: var(--line);
}

.sign-icon {
  font-size: 36rpx;
}

.sign-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--tomato);
}

.sign.done .sign-text {
  color: var(--ink3);
}

.overview {
  display: flex;
  margin: 0 44rpx;
  padding: 32rpx 0;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-divider {
  border-right: 2rpx solid var(--line);
  border-left: 2rpx solid var(--line);
}

.ov-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--ink2);
}

.ov-icon {
  font-size: 28rpx;
}

.ov-val {
  font-family: serif;
  font-size: 44rpx;
  color: var(--ink);
  margin-top: 10rpx;
}

.ov-unit {
  font-size: 24rpx;
  color: var(--ink3);
}

.challenge {
  display: flex;
  align-items: center;
  margin: 24rpx 44rpx 0;
  padding: 28rpx 32rpx;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
}

.challenge-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background-color: var(--goldSoft);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.challenge-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.challenge-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.challenge-sub {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 6rpx;
}

.challenge-sub.done {
  color: var(--gold);
}

.bar {
  margin-top: 16rpx;
  height: 12rpx;
  border-radius: 198rpx;
  background-color: var(--surface2);
  overflow: hidden;
}

.bar-fill {
  height: 12rpx;
  border-radius: 198rpx;
  background-color: var(--leaf);
}

.bar-fill.gold {
  background-color: var(--gold);
}

.challenge-adjust {
  font-size: 22rpx;
  color: var(--ink2);
  padding-left: 16rpx;
}

.ai-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 44rpx 0;
  padding: 26rpx 32rpx;
  background-color: var(--leafSoft);
  border-radius: 32rpx;
}

.ai-badge-sm {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background-color: var(--leaf);
  color: #ffffff;
  font-family: serif;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.ai-card-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 36rpx;
  color: var(--ink);
}

.ai-card-arrow {
  font-size: 36rpx;
  color: var(--ink2);
  flex: none;
}

.todo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 44rpx 20rpx;
}

.todo-title {
  font-family: serif;
  font-size: 34rpx;
  color: var(--ink);
}

.todo-add {
  font-size: 26rpx;
  color: var(--leafDeep);
  font-weight: 500;
}

.todo-scroll {
  flex: 1;
  padding: 0 44rpx;
  box-sizing: border-box;
  background-color: var(--bg);
}

.todo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.todo-empty-icon {
  font-size: 96rpx;
}

.todo-empty-text {
  font-size: 28rpx;
  color: var(--ink2);
  margin-top: 24rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  position: relative;
}

.drag-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background-color: var(--leaf);
  border-radius: 6rpx;
  box-shadow: 0 0 12rpx rgba(110, 155, 87, 0.6);
  z-index: 30;
}

.task.dragging {
  box-shadow: 0 16rpx 40rpx rgba(44, 58, 40, 0.22);
  opacity: 0.96;
  z-index: 5;
  transition: none;
}

.todo-area {
  width: 100%;
}

.task {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.task.done {
  background-color: var(--surface2);
  opacity: 0.6;
}

.check {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--ink3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check.checked {
  background-color: var(--leaf);
  border-color: var(--leaf);
}

.check-mark {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

.task-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.task-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.task-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.task.done .task-title {
  text-decoration: line-through;
}

.diff {
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 198rpx;
  padding: 2rpx 14rpx;
}

.diff-easy {
  color: var(--leaf);
  background-color: var(--leafSoft);
}

.diff-medium {
  color: var(--gold);
  background-color: var(--goldSoft);
}

.diff-hard {
  color: var(--tomato);
  background-color: var(--tomatoSoft);
}

.task-meta {
  font-size: 23rpx;
  color: var(--ink3);
  margin-top: 8rpx;
}

.task-start {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 198rpx;
  background-color: var(--leaf);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 500;
  flex: none;
}

.task-del {
  font-size: 24rpx;
  color: var(--tomato);
  padding: 8rpx 12rpx;
  flex: none;
}

.bottom-space {
  height: 220rpx;
}

/* ===== 弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(30, 40, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  width: 80%;
  padding: 44rpx;
  background-color: var(--surface);
  border-radius: 44rpx;
  box-sizing: border-box;
}

.modal-center {
  align-items: center;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-family: serif;
  font-size: 34rpx;
  color: var(--ink);
  margin-bottom: 28rpx;
}

.modal-title.center {
  text-align: center;
  margin-bottom: 0;
}

.modal-sub.center {
  text-align: center;
  margin-top: 8rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: var(--ink2);
}

.input {
  height: 92rpx;
  background-color: var(--glass);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.ph {
  color: var(--ink3);
}

.label {
  font-size: 24rpx;
  color: var(--ink3);
  margin-bottom: 12rpx;
}

.dur-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dur {
  font-size: 26rpx;
  color: var(--ink);
  background-color: var(--surface2);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
}

.dur.active {
  color: #ffffff;
  background-color: var(--leaf);
  border-color: var(--leaf);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.btn-ghost {
  color: var(--ink2);
  border: 2rpx solid var(--line);
}

.btn-solid {
  color: #ffffff;
  font-weight: 500;
  background-color: var(--leaf);
}

.goal-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background-color: var(--goldSoft);
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.goal-options {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 32rpx;
}

.goal-opt {
  flex: 1;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 28rpx;
  color: var(--ink);
  background-color: var(--surface2);
  border: 2rpx solid var(--line);
}

.goal-opt.active {
  color: #ffffff;
  background-color: var(--leaf);
  border-color: var(--leaf);
}

/**index.wxss**/
page {
  height: 100%;
  background-color: #f3f6ee;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f3f6ee;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 44rpx 32rpx;
}

.title {
  font-family: serif;
  font-size: 48rpx;
  color: #2c3a28;
}

.subtitle {
  font-size: 24rpx;
  color: #84917d;
  margin-top: 6rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 198rpx;
  font-size: 25rpx;
  font-weight: 500;
}

.pill-icon {
  font-size: 24rpx;
}

.pill-soft {
  background-color: #dce8cf;
  color: #4c7a3e;
}

.pill-solid {
  background-color: #6e9b57;
  color: #ffffff;
}

.user-chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.locked {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 44rpx;
}

.locked-icon {
  font-size: 112rpx;
}

.locked-title {
  font-family: serif;
  font-size: 40rpx;
  color: #2c3a28;
  margin-top: 24rpx;
}

.locked-desc {
  font-size: 26rpx;
  color: #84917d;
  text-align: center;
  width: 520rpx;
  margin-top: 16rpx;
}

.locked-btn {
  padding: 22rpx 48rpx;
  border-radius: 198rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 36rpx;
}

.scroll {
  flex: 1;
  padding: 0 44rpx;
  box-sizing: border-box;
}

.error {
  font-size: 24rpx;
  color: #e07a5f;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: serif;
  font-size: 32rpx;
  color: #2c3a28;
  margin-bottom: 24rpx;
}

.empty {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #84917d;
  margin-top: 24rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #b4bfae;
  margin-top: 12rpx;
  text-align: center;
}

.room-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-card {
  background-color: #ffffff;
  border: 2rpx solid #e3e9db;
  border-radius: 32rpx;
  padding: 28rpx;
}

.room-row {
  display: flex;
  align-items: flex-start;
}

.room-main {
  flex: 1;
  min-width: 0;
}

.room-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.room-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c3a28;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 198rpx;
}

.tag-gold {
  color: #d9a441;
  background-color: #f4e8ce;
}

.tag-tomato {
  color: #e07a5f;
  background-color: #f6e1d6;
}

.room-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.room-id {
  font-size: 21rpx;
  color: #b4bfae;
}

.room-copy {
  font-size: 20rpx;
  color: #4c7a3e;
  background-color: #dce8cf;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.room-meta {
  display: block;
  font-size: 22rpx;
  color: #b4bfae;
  margin-top: 4rpx;
}

.room-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 12rpx;
}

.icon-btn {
  font-size: 32rpx;
  padding: 8rpx;
}

.icon-btn.danger {
  font-size: 28rpx;
  color: #b4bfae;
}

.text-btn {
  font-size: 24rpx;
  padding: 8rpx;
}

.text-btn.danger {
  color: #e07a5f;
}

.bottom-space {
  height: 40rpx;
}

/* ===== 弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(30, 40, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 600rpx;
  padding: 44rpx;
  background-color: #ffffff;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.modal-title {
  font-family: serif;
  font-size: 34rpx;
  color: #2c3a28;
}

.modal-title.center {
  text-align: center;
  width: 100%;
}

.modal-sub {
  font-size: 23rpx;
  color: #b4bfae;
  margin: 12rpx 0 28rpx;
}

.input {
  height: 92rpx;
  background-color: #eaf1e2;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #2c3a28;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.ph {
  color: #b4bfae;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #2c3a28;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.btn-ghost {
  color: #84917d;
  border: 2rpx solid #e3e9db;
}

.btn-solid {
  color: #ffffff;
  font-weight: 500;
  background-color: #6e9b57;
}

.btn-tomato {
  color: #ffffff;
  font-weight: 500;
  background-color: #e07a5f;
}

.confirm-text {
  font-size: 25rpx;
  color: #84917d;
  line-height: 40rpx;
  text-align: center;
  margin-top: 16rpx;
}

/* ===== 留言弹窗 ===== */
.modal-board {
  width: 88%;
  padding: 40rpx;
}

.board-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.board-head-left {
  flex: 1;
  min-width: 0;
}

.board-room-name {
  font-size: 23rpx;
  color: #b4bfae;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.close-x {
  font-size: 36rpx;
  color: #b4bfae;
  padding-left: 16rpx;
}

.board-scroll {
  max-height: 760rpx;
}

.reply-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #dce8cf;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.reply-bar-text {
  font-size: 23rpx;
  color: #4c7a3e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.reply-bar-cancel {
  font-size: 23rpx;
  color: #b4bfae;
  padding-left: 16rpx;
}

.board-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.board-input {
  flex: 1;
  height: 80rpx;
  background-color: #eaf1e2;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #2c3a28;
  box-sizing: border-box;
}

.board-send {
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

.nickname-input {
  height: 72rpx;
  background-color: #eaf1e2;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  color: #2c3a28;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.board-error {
  font-size: 22rpx;
  color: #e07a5f;
  margin-top: 16rpx;
}

.board-empty {
  font-size: 24rpx;
  color: #b4bfae;
  text-align: center;
  margin: 36rpx 0 12rpx;
}

.board-list {
  margin-top: 28rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.msg-avatar {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.msg-name {
  font-size: 25rpx;
  font-weight: 500;
  color: #2c3a28;
}

.msg-time {
  font-size: 21rpx;
  color: #b4bfae;
}

.msg-text {
  font-size: 26rpx;
  color: #2c3a28;
  line-height: 38rpx;
  margin-top: 6rpx;
  word-break: break-all;
}

.msg-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 8rpx;
}

.msg-action {
  font-size: 21rpx;
  color: #4c7a3e;
}

.msg-action.liked {
  color: #e07a5f;
}

.msg-action.danger {
  color: #e07a5f;
}

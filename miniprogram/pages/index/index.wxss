/**index.wxss**/
page {
  height: 100%;
  background-color: #f3f6ee;
}

.page {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 110rpx - env(safe-area-inset-bottom));
  background-color: #f3f6ee;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 44rpx 24rpx;
}

.title {
  font-family: serif;
  font-size: 48rpx;
  color: #2c3a28;
}

.subtitle {
  font-size: 24rpx;
  color: #84917d;
  margin-top: 6rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  border-radius: 198rpx;
  font-size: 25rpx;
  font-weight: 500;
}

.pill-icon {
  font-size: 24rpx;
}

.pill-soft {
  background-color: #dce8cf;
  color: #4c7a3e;
}

.pill-solid {
  background-color: #6e9b57;
  color: #ffffff;
}

.scroll {
  flex: 1;
  padding: 0 44rpx;
  box-sizing: border-box;
}

.error {
  font-size: 24rpx;
  color: #e07a5f;
  margin-bottom: 20rpx;
}

/* 入口卡片 */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 32rpx;
}

.entry-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background-color: #ffffff;
  border: 2rpx solid #e3e9db;
  border-radius: 36rpx;
}

.entry-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background-color: #dce8cf;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-title {
  font-family: serif;
  font-size: 34rpx;
  color: #2c3a28;
  margin-top: 28rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: #b4bfae;
  margin-top: 12rpx;
}

/* 房间详情 */
.room-top {
  display: flex;
  align-items: flex-start;
}

.room-top-left {
  flex: 1;
  min-width: 0;
}

.room-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3a28;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.join-code {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.jc-label {
  font-size: 22rpx;
  color: #b4bfae;
}

.jc-value {
  font-size: 27rpx;
  font-weight: 500;
  color: #84917d;
}

.jc-copy {
  font-size: 24rpx;
  color: #6e9b57;
}

.member-pill {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b4bfae;
  background-color: #eaf1e2;
  padding: 4rpx 16rpx;
  border-radius: 198rpx;
}

.room-top-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: none;
  padding-left: 20rpx;
}

.big-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #e07a5f;
}

.big-label {
  font-size: 21rpx;
  color: #b4bfae;
}

.room-top-right .big-num:nth-child(3) {
  margin-top: 16rpx;
}

.room-ops {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.op-pill {
  font-size: 25rpx;
  color: #84917d;
  padding: 14rpx 26rpx;
  border-radius: 198rpx;
  border: 2rpx solid #e3e9db;
}

.op-active {
  color: #4c7a3e;
  font-weight: 500;
  background-color: #dce8cf;
  border-color: #dce8cf;
}

.daily-hint {
  font-size: 22rpx;
  color: #b4bfae;
  margin-top: 20rpx;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.rank-title {
  font-family: serif;
  font-size: 30rpx;
  color: #2c3a28;
}

.rank-tip {
  font-size: 21rpx;
  color: #b4bfae;
}

.no-member {
  font-size: 25rpx;
  color: #b4bfae;
  padding: 24rpx 0;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background-color: #ffffff;
  border: 2rpx solid #e3e9db;
  border-radius: 28rpx;
}

.rank-badge {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rank-badge.r0 { background-color: #d9a441; }
.rank-badge.r1 { background-color: #84917d; }
.rank-badge.r2 { background-color: #e07a5f; }
.rank-badge.r3 { background-color: #e3e9db; color: #84917d; }

.member-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c3a28;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag-owner {
  font-size: 20rpx;
  color: #d9a441;
  background-color: #f4e8ce;
  padding: 4rpx 12rpx;
  border-radius: 198rpx;
  flex: none;
}

.member-sub {
  font-size: 23rpx;
  color: #b4bfae;
  margin-top: 6rpx;
}

.member-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.mtag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 198rpx;
}

.mtag-tomato {
  color: #e07a5f;
  background-color: #f6e1d6;
}

.mtag-gold {
  color: #d9a441;
  background-color: #f4e8ce;
}

.member-right {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 16rpx;
}

.member-min {
  font-size: 40rpx;
  font-weight: bold;
  color: #84917d;
}

.member-min-label {
  font-size: 20rpx;
  color: #b4bfae;
}

.danger-btn {
  margin-top: 36rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 28rpx;
  border: 2rpx solid #e3e9db;
  color: #e07a5f;
  font-size: 28rpx;
}

.bottom-space {
  height: 40rpx;
}

/* ===== 弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(30, 40, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.modal {
  width: 600rpx;
  padding: 44rpx;
  background-color: #ffffff;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.modal-title {
  font-family: serif;
  font-size: 34rpx;
  color: #2c3a28;
}

.modal-title.center {
  text-align: center;
  width: 100%;
}

.modal-sub {
  font-size: 23rpx;
  color: #b4bfae;
  margin: 12rpx 0 28rpx;
}

.input {
  height: 92rpx;
  background-color: #eaf1e2;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #2c3a28;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.ph {
  color: #b4bfae;
}

.switch-row,
.daily-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #2c3a28;
}

.daily-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.daily-input {
  width: 140rpx;
  height: 72rpx;
  background-color: #eaf1e2;
  border-radius: 18rpx;
  text-align: right;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c3a28;
  box-sizing: border-box;
}

.daily-unit {
  font-size: 24rpx;
  color: #b4bfae;
}

.daily-tip {
  font-size: 21rpx;
  color: #b4bfae;
  margin-bottom: 8rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.btn-ghost {
  color: #84917d;
  border: 2rpx solid #e3e9db;
}

.btn-solid {
  color: #ffffff;
  font-weight: 500;
  background-color: #6e9b57;
}

.btn-tomato {
  color: #ffffff;
  font-weight: 500;
  background-color: #e07a5f;
}

.btn-disabled {
  color: #ffffff;
  background-color: #e3e9db;
}

.confirm-text {
  font-size: 25rpx;
  color: #84917d;
  line-height: 40rpx;
  text-align: center;
  margin-top: 16rpx;
}

/* 留言弹窗 */
.modal-board {
  width: 88%;
  padding: 40rpx;
}

.board-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.board-head-left {
  flex: 1;
  min-width: 0;
}

.board-room-name {
  font-size: 23rpx;
  color: #b4bfae;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.close-x {
  font-size: 36rpx;
  color: #b4bfae;
  padding-left: 16rpx;
}

.board-scroll {
  max-height: 760rpx;
}

.reply-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #dce8cf;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.reply-bar-text {
  font-size: 23rpx;
  color: #4c7a3e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.reply-bar-cancel {
  font-size: 23rpx;
  color: #b4bfae;
  padding-left: 16rpx;
}

.board-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.board-input {
  flex: 1;
  height: 80rpx;
  background-color: #eaf1e2;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #2c3a28;
  box-sizing: border-box;
}

.board-send {
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

.board-error {
  font-size: 22rpx;
  color: #e07a5f;
  margin-top: 16rpx;
}

.board-empty {
  font-size: 24rpx;
  color: #b4bfae;
  text-align: center;
  margin: 36rpx 0 12rpx;
}

.board-list {
  margin-top: 28rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.msg-avatar {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.msg-name {
  font-size: 25rpx;
  font-weight: 500;
  color: #2c3a28;
}

.msg-time {
  font-size: 21rpx;
  color: #b4bfae;
}

.msg-text {
  font-size: 26rpx;
  color: #2c3a28;
  line-height: 38rpx;
  margin-top: 6rpx;
  word-break: break-all;
}

.msg-reply {
  font-size: 21rpx;
  color: #4c7a3e;
  margin-top: 8rpx;
}

/* 未登录 */
.locked {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 44rpx;
}

.locked-icon {
  font-size: 112rpx;
}

.locked-title {
  font-family: serif;
  font-size: 40rpx;
  color: #2c3a28;
  margin-top: 24rpx;
}

.locked-desc {
  font-size: 26rpx;
  color: #84917d;
  text-align: center;
  width: 520rpx;
  margin-top: 16rpx;
}

.locked-btn {
  padding: 22rpx 48rpx;
  border-radius: 198rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 36rpx;
}

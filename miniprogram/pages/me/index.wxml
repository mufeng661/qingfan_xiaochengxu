<!--pages/me/index.wxml-->
<view class="page">
  <view class="profile" wx:if="{{loggedIn}}">
    <view class="avatar">{{avatarSeed}}</view>
    <view class="profile-info">
      <view class="nickname">{{nickname}}</view>
      <view class="phone">Lv.{{level}} · 连续 {{streak}} 天</view>
    </view>
  </view>

  <view class="profile" wx:else>
    <view class="avatar guest">访</view>
    <view class="profile-info">
      <view class="nickname">未登录</view>
      <view class="phone">登录后保存你的专注数据</view>
    </view>
    <view class="login-btn" bindtap="goLogin">去登录</view>
  </view>

  <view class="level-card" wx:if="{{loggedIn}}">
    <view class="level-row">
      <text>等级 Lv.{{level}}</text>
      <text class="level-exp">{{exp}} / {{nextLevelExp}} 经验</text>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width: {{expPercent}}%"></view>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat">
      <view class="stat-val">{{totalMinutes}}</view>
      <view class="stat-label">累计专注（分钟）</view>
    </view>
    <view class="stat">
      <view class="stat-val">{{pomodoroTotal}}</view>
      <view class="stat-label">累计番茄</view>
    </view>
    <view class="stat">
      <view class="stat-val">{{streak}}</view>
      <view class="stat-label">连续（天）</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="comingSoon"><text class="menu-icon">🏅</text><text class="menu-text">我的徽章</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="comingSoon"><text class="menu-icon">🔔</text><text class="menu-text">通知设置</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="comingSoon"><text class="menu-icon">🎨</text><text class="menu-text">主题外观</text><text class="menu-arrow">›</text></view>
  </view>

  <view class="logout" wx:if="{{loggedIn}}" bindtap="logout">退出登录</view>
</view>

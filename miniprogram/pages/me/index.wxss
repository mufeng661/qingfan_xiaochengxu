/**pages/me/index.wxss**/
page {
  background-color: var(--bg);
}

.page {
  min-height: 100vh;
  padding: 40rpx 44rpx 130rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: var(--bg);
}

/* ===== 游客视图 ===== */
.guest {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.guest-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guest-logo {
  font-size: 144rpx;
}

.guest-name {
  font-family: serif;
  font-size: 60rpx;
  color: var(--ink);
  margin-top: 16rpx;
}

.guest-slogan {
  font-size: 28rpx;
  color: var(--ink2);
  margin-top: 16rpx;
}

.guest-features {
  width: 100%;
  margin-top: 48rpx;
  padding: 32rpx;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  box-sizing: border-box;
}

.guest-feature {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.gf-icon {
  font-size: 32rpx;
}

.gf-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.gf-desc {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 4rpx;
}

.guest-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 28rpx;
  background-color: var(--leaf);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-top: 40rpx;
  box-shadow: 0 16rpx 36rpx rgba(110, 155, 87, 0.32);
}

.guest-hint {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 20rpx;
}

/* ===== 个人信息 ===== */
.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 36rpx;
}

.avatar-wrap {
  position: relative;
  flex: none;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: linear-gradient(135deg, var(--leaf), var(--leafDeep));
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lv-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: var(--gold);
  border: 4rpx solid #ffffff;
  border-radius: 198rpx;
  padding: 2rpx 12rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
}

.chevron {
  font-size: 28rpx;
  color: var(--ink3);
}

.bio {
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 通用卡片 ===== */
.card {
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-family: serif;
  font-size: 32rpx;
  color: var(--ink);
}

.card-label {
  font-size: 26rpx;
  color: var(--ink2);
}

.hint {
  font-size: 22rpx;
  color: var(--ink3);
}

.exp-val {
  font-family: serif;
  font-size: 30rpx;
  color: var(--ink);
}

.exp-max {
  font-size: 22rpx;
  color: var(--ink3);
}

.bar {
  height: 16rpx;
  border-radius: 198rpx;
  background-color: var(--surface2);
  overflow: hidden;
}

.bar-fill {
  height: 16rpx;
  border-radius: 198rpx;
  background: linear-gradient(90deg, var(--leaf), var(--gold));
}

.card .hint {
  margin-top: 16rpx;
}

/* ===== 签到 ===== */
.sign-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background-color: var(--tomatoSoft);
  border: 2rpx solid #f0c9b8;
  margin-bottom: 32rpx;
}

.sign-card.done {
  background-color: var(--surface);
  border-color: var(--line);
}

.sign-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: var(--tomato);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.sign-card.done .sign-icon {
  background-color: var(--surface2);
}

.sign-body {
  flex: 1;
  min-width: 0;
}

.sign-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.sign-sub {
  font-size: 24rpx;
  color: var(--tomato);
  margin-top: 4rpx;
}

.sign-card.done .sign-sub {
  color: var(--ink3);
}

.sign-action {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--tomato);
  flex: none;
}

.sign-card.done .sign-action {
  color: var(--ink3);
}

/* ===== 番茄园 ===== */
.forest-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.forest-level {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--tomato);
  background-color: var(--tomatoSoft);
  border-radius: 198rpx;
  padding: 4rpx 18rpx;
}

.forest-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0 16rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background-color: var(--surface2);
  box-shadow: inset 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.forest-cell {
  width: calc((100% - 36rpx) / 4);
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  box-sizing: border-box;
}

.forest-cell.tomato {
  background-color: var(--surface);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.06);
}

.forest-cell.tomato.fresh {
  animation: tomato-pop 0.5s cubic-bezier(0.2, 1.3, 0.4, 1) both;
}

.forest-cell.dead {
  background-color: var(--surface);
  font-size: 38rpx;
  filter: grayscale(1);
  opacity: 0.6;
}

.forest-cell.empty {
  border: 3rpx dashed var(--line);
}

.forest-cell.more {
  background-color: var(--tomatoSoft);
  color: var(--tomato);
  font-size: 28rpx;
  font-weight: 700;
}

.forest-stats {
  font-size: 24rpx;
  color: var(--ink3);
  margin-bottom: 8rpx;
}

@keyframes tomato-pop {
  0% { transform: scale(0.2); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ===== 本周 ===== */
.week-row {
  display: flex;
  margin-top: 8rpx;
}

.week-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.week-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink3);
  border: 2rpx dashed var(--line);
  box-sizing: border-box;
}

.week-dot.done {
  background-color: var(--leaf);
  color: #ffffff;
  border: none;
  font-weight: bold;
}

.week-dot.today {
  border: 3rpx solid var(--tomato);
  color: var(--tomato);
  background-color: var(--tomatoSoft);
}

.week-label {
  font-size: 20rpx;
  color: var(--ink3);
}

/* ===== 徽章 ===== */
.badge-card {
  margin-bottom: 36rpx;
}

.badge-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.badge-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 32rpx 8rpx;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
}

.badge-item.locked {
  opacity: 0.6;
}

.badge-name {
  font-size: 20rpx;
  color: var(--ink2);
}

/* ===== 累计 ===== */
.total-card {
  display: flex;
  padding: 32rpx 0;
}

.total-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-divider {
  border-left: 2rpx solid var(--line);
  border-right: 2rpx solid var(--line);
}

.total-val {
  font-family: serif;
  font-size: 38rpx;
  color: var(--ink);
}

.total-label {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}

/* ===== 设置 ===== */
.settings {
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f0f3ea;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-color: var(--surface2);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.setting-body {
  flex: 1;
  min-width: 0;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.setting-desc {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 4rpx;
}

/* ===== 退出 ===== */
.logout-btn {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 36rpx;
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  color: var(--tomato);
  font-size: 28rpx;
  font-weight: 500;
}

.bottom-space {
  height: 40rpx;
}

/* ===== 弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(30, 40, 26, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.modal {
  width: 600rpx;
  padding: 44rpx;
  background-color: var(--surface);
  border-radius: 44rpx;
  box-sizing: border-box;
}

.modal-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-family: serif;
  font-size: 34rpx;
  color: var(--ink);
}

.modal-title.center {
  text-align: center;
  margin-top: 16rpx;
}

.close-x {
  font-size: 36rpx;
  color: var(--ink3);
}

.confirm-text {
  font-size: 25rpx;
  color: var(--ink2);
  line-height: 40rpx;
  text-align: center;
  margin-top: 16rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.btn.full {
  width: 100%;
  margin-top: 28rpx;
}

.btn-ghost {
  color: var(--ink2);
  border: 2rpx solid var(--line);
}

.btn-solid {
  color: #ffffff;
  font-weight: 500;
  background-color: var(--leaf);
}

.btn-tomato {
  color: #ffffff;
  font-weight: 500;
  background-color: var(--tomato);
}

.badge-big {
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  background-color: var(--goldSoft);
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-state {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 24rpx;
  background-color: var(--surface2);
  color: var(--ink3);
  font-size: 25rpx;
  margin-top: 28rpx;
}

.badge-state.on {
  background-color: var(--leafSoft);
  color: var(--leafDeep);
}

/* ===== 3D 徽章 ===== */
.badge-canvas {
  width: 360rpx;
  height: 360rpx;
  display: block;
  margin: 0 auto;
}

/* 成就徽章墙弹窗（浅色面板 + 顶部聚光灯） */
.badge-modal {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf1fa 0%, #f7faff 32%, #ffffff 62%, #f2f6fc 100%);
}

.badge-modal::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  pointer-events: none;
  background:
    radial-gradient(46% 100% at 50% 0%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 72%),
    radial-gradient(30% 86% at 16% 0%, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0) 72%),
    radial-gradient(30% 86% at 84% 0%, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0) 72%);
}

.badge-wall-title {
  position: relative;
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3340;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.badge-name-big {
  position: relative;
  font-size: 32rpx;
  color: #3a4150;
  font-weight: 500;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.badge-rarity {
  font-size: 20rpx;
  font-weight: 400;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.badge-rarity.r-stone { background: #e7eae5; color: #77836f; }
.badge-rarity.r-bronze { background: #f3e2d3; color: #8a5524; }
.badge-rarity.r-silver { background: #e4eaf0; color: #5c6a78; }
.badge-rarity.r-gold { background: #f7ecc9; color: #9a6d0a; }
.badge-rarity.r-diamond { background: #d9f1f8; color: #1f6a86; }

.badge-modal .confirm-text,
.badge-modal .badge-state,
.badge-modal .btn-solid {
  position: relative;
}

/* 徽章列表：金属硬币样式，按稀有度区分材质 */
.badge-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #fff8e0, #f3d271 45%, #d9a441 62%, #8a5c12);
  color: #5a3d0e;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.22), inset 0 6rpx 10rpx rgba(255, 255, 255, 0.5), 0 8rpx 16rpx rgba(0, 0, 0, 0.15);
}

.badge-icon.bronze {
  background: radial-gradient(circle at 35% 28%, #ffe6cf, #e8b48a 45%, #b5793f 62%, #6e4418);
  color: #5a3312;
}

.badge-icon.silver {
  background: radial-gradient(circle at 35% 28%, #ffffff, #e8edf2 45%, #b9c2cc 62%, #6e7a86);
  color: #45505c;
}

.badge-icon.diamond {
  background: radial-gradient(circle at 35% 28%, #f4feff, #bfeef7 45%, #7fd4e8 62%, #3a8fb0);
  color: #1f5a70;
}

.badge-item.locked .badge-icon {
  background: linear-gradient(135deg, #dfe3de, #b4bfae);
  color: #ffffff;
  box-shadow: inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.12), 0 6rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stage {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 900rpx;
}

.coin {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  transform-style: preserve-3d;
}

.coin.spinning {
  animation: coinSpin 4s linear infinite;
}

@keyframes coinSpin {
  from {
    transform: rotateY(0deg);
  }
  to {
    transform: rotateY(360deg);
  }
}

.coin-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.coin-face.front {
  background: radial-gradient(circle at 35% 28%, #ffeec2, #d9a441 55%, #a9791f);
  border: 10rpx solid #f6e6bd;
  box-shadow: inset 0 -10rpx 24rpx rgba(120, 80, 10, 0.35), inset 0 10rpx 18rpx rgba(255, 255, 255, 0.6), 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
  color: #5a3d0e;
}

.coin-face.back {
  transform: rotateY(180deg);
  background: radial-gradient(circle at 65% 28%, #ffe6a8, #c8901f 55%, #8f6517);
  border: 10rpx solid #f0dca6;
  box-shadow: inset 0 -10rpx 24rpx rgba(120, 80, 10, 0.35), 0 16rpx 30rpx rgba(0, 0, 0, 0.22);
  color: #5a3d0e;
}

.coin-icon {
  font-size: 88rpx;
  line-height: 1;
}

.coin-name {
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.coin-back {
  font-family: serif;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
}

.coin-hint {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 16rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f3ea;
}

.kv-k {
  font-size: 27rpx;
  color: var(--ink2);
}

.kv-v {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f3ea;
}

.toggle-row:last-child {
  border-bottom: none;
}

.toggle-label {
  font-size: 27rpx;
  color: var(--ink);
}

.toggle-body {
  flex: 1;
  min-width: 0;
}

.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.about-logo {
  font-size: 128rpx;
}

.about-name {
  font-family: serif;
  font-size: 40rpx;
  color: var(--ink);
  margin-top: 20rpx;
}

.about-text {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 40rpx;
  text-align: center;
  margin-top: 24rpx;
  white-space: pre-wrap;
}

/* ===== 主题选择 ===== */
.theme-row {
  display: flex;
}

.theme-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.theme-swatch {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--line);
  box-sizing: border-box;
}

.theme-swatch.on {
  border-color: var(--leaf);
}

.theme-check {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.theme-name {
  font-size: 22rpx;
  color: var(--ink2);
}

.theme-name.on {
  color: var(--ink);
  font-weight: 500;
}

/**pages/feedback/index.wxss**/
page {
  background-color: #f3f6ee;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg);
  padding: 0 44rpx 60rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 20rpx;
}

.back {
  font-size: 48rpx;
  color: var(--ink);
  padding-right: 8rpx;
}

.title {
  font-family: serif;
  font-size: 40rpx;
  color: var(--ink);
}

.card {
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
}

.label {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  background-color: var(--glass);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.ph {
  color: var(--ink3);
}

.count {
  text-align: right;
  font-size: 22rpx;
  color: var(--ink3);
  margin: 10rpx 0 28rpx;
}

.input {
  height: 88rpx;
  background-color: var(--glass);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.submit {
  margin-top: 36rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 28rpx;
  background-color: var(--leaf);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.submit.disabled {
  opacity: 0.6;
}

.tip {
  font-size: 23rpx;
  line-height: 38rpx;
  color: var(--ink3);
  margin-top: 28rpx;
}

.mail {
  color: var(--leafDeep);
}

.bottom-space {
  height: 40rpx;
}

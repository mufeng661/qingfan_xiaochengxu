/**pages/data/index.wxss**/
page {
  background-color: var(--bg);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg);
}

.header {
  padding: 40rpx 44rpx 20rpx;
}

.title {
  font-family: serif;
  font-size: 48rpx;
  color: var(--ink);
}

.scroll {
  flex: 1;
  padding: 0 44rpx;
  box-sizing: border-box;
  background-color: var(--bg);
}

.card {
  background-color: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-family: serif;
  font-size: 29rpx;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.card-sub {
  font-size: 22rpx;
  color: var(--ink3);
}

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 36rpx;
  font-weight: bold;
}

.stat-val.tomato {
  color: var(--tomato);
}

.stat-val.leaf {
  color: var(--leafDeep);
}

.stat-val.gold {
  color: var(--gold);
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink3);
  margin-top: 8rpx;
}

.pills {
  display: flex;
  gap: 10rpx;
}

.pill {
  font-size: 24rpx;
  color: var(--ink2);
  padding: 8rpx 20rpx;
  border-radius: 198rpx;
  border: 2rpx solid var(--line);
}

.pill.active {
  color: #ffffff;
  background-color: var(--leaf);
  border-color: var(--leaf);
}

.empty-line {
  font-size: 24rpx;
  color: var(--ink3);
  padding: 20rpx 0;
}

.pie-row {
  display: flex;
  align-items: center;
}

.pie-canvas {
  width: 264rpx;
  height: 264rpx;
  flex: none;
}

.legend {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  flex: none;
}

.legend-name {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-pct {
  font-size: 22rpx;
  color: var(--ink3);
  flex: none;
}

.month-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-title {
  font-family: serif;
  font-size: 29rpx;
  font-weight: 500;
  color: var(--tomato);
}

.month-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--tomato);
  margin-left: 12rpx;
}

.month-spacer {
  flex: 1;
}

.month-icon {
  font-size: 34rpx;
  color: var(--ink3);
  padding: 0 16rpx;
}

.month-nav {
  font-size: 40rpx;
  color: var(--tomato);
  padding: 0 12rpx;
}

.month-nav.disabled {
  color: var(--line);
}

.chart-row {
  display: flex;
}

.y-axis {
  width: 88rpx;
  height: 158px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
  box-sizing: border-box;
  flex: none;
}

.axis-label {
  font-size: 20rpx;
  color: var(--ink3);
}

.chart-scroll {
  flex: 1;
  margin-left: 8rpx;
  white-space: nowrap;
}

.chart-inner {
  display: inline-block;
}

.chart-canvas {
  width: 100%;
}

.x-axis {
  display: flex;
  margin-top: 8rpx;
}

.x-label {
  width: 44px;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink3);
}

.bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.bar-name {
  width: 144rpx;
  font-size: 23rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: none;
}

.bar-track {
  flex: 1;
  height: 28rpx;
  border-radius: 14rpx;
  background-color: var(--surface2);
  overflow: hidden;
}

.bar-fill {
  height: 28rpx;
  border-radius: 14rpx;
  background-color: var(--tomato);
}

.bar-count {
  width: 48rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink3);
  flex: none;
}

.ai-card {
  background-color: var(--leafSoft);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.ai-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ai-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background-color: var(--leaf);
  color: #ffffff;
  font-family: serif;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-title {
  font-family: serif;
  font-size: 29rpx;
  color: var(--ink);
}

.ai-text {
  font-size: 25rpx;
  line-height: 42rpx;
  color: var(--ink);
}

.bottom-space {
  height: 220rpx;
}

/* 热力图 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(20, 26, 16, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.heat-modal {
  width: 86%;
  padding: 40rpx;
  background-color: var(--surface);
  border-radius: 40rpx;
  box-sizing: border-box;
}

.heat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.heat-title {
  font-family: serif;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--ink);
}

.heat-sub {
  font-size: 26rpx;
  color: var(--ink3);
  text-align: center;
  margin: 12rpx 0 24rpx;
}

.heat-weekdays {
  display: flex;
  margin-bottom: 12rpx;
}

.heat-wd {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink3);
}

.heat-week {
  display: flex;
}

.heat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.heat-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.heat-box.filled {
  display: flex;
  align-items: center;
  justify-content: center;
}

.heat-dur {
  font-size: 18rpx;
  color: #ffffff;
}

.heat-day {
  font-size: 20rpx;
  color: var(--ink3);
  margin-top: 6rpx;
  height: 28rpx;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
}

.heat-lg-text {
  font-size: 20rpx;
  color: var(--ink3);
}

.heat-lg {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background-color: var(--tomato);
}

/**pages/complete/index.wxss**/
page {
  height: 100%;
}

.page {
  height: 100vh;
  background: linear-gradient(160deg, #5e7a52 0%, #39503a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  width: 580rpx;
  padding: 44rpx;
  background-color: #ffffff;
  border-radius: 44rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.confetti {
  display: flex;
  gap: 36rpx;
  font-size: 16rpx;
  height: 60rpx;
  align-items: center;
}

.tomato {
  font-size: 92rpx;
  line-height: 1;
}

.done-title {
  font-family: serif;
  font-size: 38rpx;
  color: #2c3a28;
  margin-top: 16rpx;
}

.done-sub {
  font-size: 25rpx;
  color: #84917d;
  margin-top: 12rpx;
}

.rewards {
  display: flex;
  gap: 24rpx;
  margin: 28rpx 0;
}

.reward {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  color: #84917d;
}

.reward-icon {
  font-size: 30rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 26rpx;
  background-color: #6e9b57;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}
